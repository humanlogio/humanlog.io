{
  "extends": [
    "next/core-web-vitals",
    "plugin:prettier/recommended"
  ],
  "rules": {
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "warn",
    "prettier/prettier": 0,
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          ".*" // no relative imports
        ]
      }
    ]
  },
  "settings": {
    "react-hooks": {
      "additionalHooks": "(useDebouncer|useAbortable)"
    }
  }
}
